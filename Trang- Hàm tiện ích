"""
A5/1 & Tiny A5/1 - Text/File Encryption Demo
- Text <-> Bit
- File <-> Bit
- A5/1 stream cipher
- Tiny A5/1 (simplified educational version)
- CLI menu

NOTE:
A5/1 is a historical GSM stream cipher. This implementation is for
educational/lab purposes and is NOT recommended for real security.
"""

# ============================================================
# 1. BIT / TEXT / FILE UTILITIES
# ============================================================

def text_to_bits(text: str) -> str:
    """UTF-8 text -> bit string."""
    data = text.encode("utf-8")
    return "".join(f"{byte:08b}" for byte in data)


def bits_to_text(bits: str) -> str:
    """Bit string -> UTF-8 text."""
    if len(bits) % 8 != 0:
        raise ValueError("Số bit phải chia hết cho 8.")

    data = bytes(
        int(bits[i:i + 8], 2)
        for i in range(0, len(bits), 8)
    )
    return data.decode("utf-8")


def file_to_bits(filename: str) -> str:
    """Binary file -> bit string."""
    with open(filename, "rb") as f:
        data = f.read()

    return "".join(f"{byte:08b}" for byte in data)


def bits_to_file(bits: str, filename: str):
    """Bit string -> binary file."""
    if len(bits) % 8 != 0:
        raise ValueError("Số bit phải chia hết cho 8.")

    data = bytes(
        int(bits[i:i + 8], 2)
        for i in range(0, len(bits), 8)
    )

    with open(filename, "wb") as f:
        f.write(data)


def xor_bits(data_bits: str, key_bits: str) -> str:
    """XOR two equal-length bit strings."""
    if len(data_bits) != len(key_bits):
        raise ValueError("Dữ liệu và keystream phải có cùng độ dài.")

    return "".join(
        str(int(a) ^ int(b))
        for a, b in zip(data_bits, key_bits)
    )


# ============================================================
# 2. A5/1
# ============================================================

class A51:
    """
    A5/1 GSM stream cipher.

    Registers:
      R1 = 19 bits
      R2 = 22 bits
      R3 = 23 bits

    This follows the standard educational A5/1 construction:
      feedback taps:
        R1: bits 13,16,17,18
        R2: bits 20,21
        R3: bits 7,20,21,22

      clocking bits:
        R1: 8
        R2: 10
        R3: 10

      output:
        R1[18] XOR R2[21] XOR R3[22]
    """

    def __init__(self, key: str, frame: int = 0):
        # Accept a binary key of 64 bits.
        if len(key) != 64 or any(c not in "01" for c in key):
            raise ValueError("Khóa A5/1 phải là đúng 64 bit.")

        if not (0 <= frame < (1 << 22)):
            raise ValueError("Frame number phải nằm trong [0, 2^22 - 1].")

        self.r1 = [0] * 19
        self.r2 = [0] * 22
        self.r3 = [0] * 23

        # Key loading: 64 cycles.
        for i, bit in enumerate(key):
            self._clock_all()
            self._xor_into_registers(int(bit))

        # Frame loading: 22 cycles.
        for i in range(22):
            self._clock_all()
            self._xor_into_registers((frame >> i) & 1)

        # Warm-up: 100 cycles.
        for _ in range(100):
            self._clock_majority()

    @staticmethod
    def _majority(a, b, c):
        return 1 if (a + b + c) >= 2 else 0

    def _clock_r1(self):
        feedback = self.r1[13] ^ self.r1[16] ^ self.r1[17] ^ self.r1[18]
        self.r1 = [feedback] + self.r1[:-1]

    def _clock_r2(self):
        feedback = self.r2[20] ^ self.r2[21]
        self.r2 = [feedback] + self.r2[:-1]

    def _clock_r3(self):
        feedback = self.r3[7] ^ self.r3[20] ^ self.r3[21] ^ self.r3[22]
        self.r3 = [feedback] + self.r3[:-1]

    def _clock_all(self):
        self._clock_r1()
        self._clock_r2()
        self._clock_r3()

    def _xor_into_registers(self, bit):
        self.r1[0] ^= bit
        self.r2[0] ^= bit
        self.r3[0] ^= bit

    def _clock_majority(self):
        m = self._majority(self.r1[8], self.r2[10], self.r3[10])

        if self.r1[8] == m:
            self._clock_r1()
        if self.r2[10] == m:
            self._clock_r2()
        if self.r3[10] == m:
            self._clock_r3()

    def get_bit(self):
        self._clock_majority()
        return self.r1[18] ^ self.r2[21] ^ self.r3[22]

    def keystream(self, n_bits: int) -> str:
        return "".join(str(self.get_bit()) for _ in range(n_bits))


# ============================================================
# 3. TINY A5/1
# ============================================================

class TinyA51:
    """
    Tiny A5/1: simplified educational version.

    Registers:
      R1 = 5 bits
      R2 = 7 bits
      R3 = 9 bits

    This is NOT the GSM A5/1 standard. It is intended to make
    the register/majority/keystream mechanism easy to demonstrate.

    Key: 16 bits
    Frame: 8 bits
    """

    def __init__(self, key: str, frame: int = 0):
        if len(key) != 16 or any(c not in "01" for c in key):
            raise ValueError("Khóa Tiny A5/1 phải là đúng 16 bit.")

        if not (0 <= frame < 256):
            raise ValueError("Frame Tiny A5/1 phải nằm trong [0, 255].")

        self.r1 = [0] * 5
        self.r2 = [0] * 7
        self.r3 = [0] * 9

        # Key loading.
        for bit in key:
            self._clock_all()
            self._xor_into_registers(int(bit))

        # Frame loading.
        for i in range(8):
            self._clock_all()
            self._xor_into_registers((frame >> i) & 1)

        # Warm-up.
        for _ in range(20):
            self._clock_majority()

    @staticmethod
    def _majority(a, b, c):
        return 1 if (a + b + c) >= 2 else 0

    def _clock_r1(self):
        feedback = self.r1[2] ^ self.r1[4]
        self.r1 = [feedback] + self.r1[:-1]

    def _clock_r2(self):
        feedback = self.r2[5] ^ self.r2[6]
        self.r2 = [feedback] + self.r2[:-1]

    def _clock_r3(self):
        feedback = self.r3[3] ^ self.r3[8]
        self.r3 = [feedback] + self.r3[:-1]

    def _clock_all(self):
        self._clock_r1()
        self._clock_r2()
        self._clock_r3()

    def _xor_into_registers(self, bit):
        self.r1[0] ^= bit
        self.r2[0] ^= bit
        self.r3[0] ^= bit

    def _clock_majority(self):
        m = self._majority(self.r1[1], self.r2[3], self.r3[4])

        if self.r1[1] == m:
            self._clock_r1()
        if self.r2[3] == m:
            self._clock_r2()
        if self.r3[4] == m:
            self._clock_r3()

    def get_bit(self):
        self._clock_majority()
        return self.r1[4] ^ self.r2[6] ^ self.r3[8]

    def keystream(self, n_bits: int) -> str:
        return "".join(str(self.get_bit()) for _ in range(n_bits))


# ============================================================
# 4. KEY / FRAME INPUT
# ============================================================

def input_a51_key():
    while True:
        key = input("Nhập khóa A5/1 (64 bit): ").strip()
        if len(key) == 64 and all(c in "01" for c in key):
            return key
        print("Khóa không hợp lệ. Phải có đúng 64 ký tự 0/1.")


def input_tiny_key():
    while True:
        key = input("Nhập khóa Tiny A5/1 (16 bit): ").strip()
        if len(key) == 16 and all(c in "01" for c in key):
            return key
        print("Khóa không hợp lệ. Phải có đúng 16 ký tự 0/1.")


def input_frame(max_value):
    while True:
        value = input(f"Nhập frame number (0..{max_value}): ").strip()
        try:
            frame = int(value)
            if 0 <= frame <= max_value:
                return frame
        except ValueError:
            pass
        print("Frame không hợp lệ.")


# ============================================================
# 5. TEXT OPERATIONS
# ============================================================

def encrypt_text(cipher_name):
    text = input("Nhập plaintext: ")

    if cipher_name == "A5/1":
        key = input_a51_key()
        frame = input_frame((1 << 22) - 1)
        cipher = A51(key, frame)
    else:
        key = input_tiny_key()
        frame = input_frame(255)
        cipher = TinyA51(key, frame)

    plain_bits = text_to_bits(text)
    key_stream = cipher.keystream(len(plain_bits))
    cipher_bits = xor_bits(plain_bits, key_stream)

    print("\n--- KẾT QUẢ ---")
    print("Plaintext :", text)
    print("Plain bits:", plain_bits)
    print("Cipher bits:", cipher_bits)
    print("Cipher hex :", bits_to_hex(cipher_bits))


def decrypt_text(cipher_name):
    cipher_bits = input("Nhập ciphertext dạng bit: ").strip()

    if not cipher_bits or any(c not in "01" for c in cipher_bits):
        print("Ciphertext phải chỉ gồm 0 và 1.")
        return

    if len(cipher_bits) % 8 != 0:
        print("Ciphertext phải có số bit chia hết cho 8.")
        return

    if cipher_name == "A5/1":
        key = input_a51_key()
        frame = input_frame((1 << 22) - 1)
        cipher = A51(key, frame)
    else:
        key = input_tiny_key()
        frame = input_frame(255)
        cipher = TinyA51(key, frame)

    key_stream = cipher.keystream(len(cipher_bits))
    plain_bits = xor_bits(cipher_bits, key_stream)

    try:
        text = bits_to_text(plain_bits)
    except UnicodeDecodeError:
        print("Không giải mã được thành UTF-8. Kiểm tra khóa/frame.")
        return

    print("\n--- KẾT QUẢ ---")
    print("Plain bits:", plain_bits)
    print("Plaintext :", text)


# ============================================================
# 6. FILE OPERATIONS
# ============================================================

def encrypt_file(cipher_name):
    input_file = input("File đầu vào: ").strip()
    output_file = input("File mã hóa đầu ra: ").strip()

    try:
        plain_bits = file_to_bits(input_file)
    except OSError as e:
        print("Không đọc được file:", e)
        return

    if cipher_name == "A5/1":
        key = input_a51_key()
        frame = input_frame((1 << 22) - 1)
        cipher = A51(key, frame)
    else:
        key = input_tiny_key()
        frame = input_frame(255)
        cipher = TinyA51(key, frame)

    key_stream = cipher.keystream(len(plain_bits))
    cipher_bits = xor_bits(plain_bits, key_stream)

    try:
        bits_to_file(cipher_bits, output_file)
        print(f"Đã mã hóa: {input_file} -> {output_file}")
    except OSError as e:
        print("Không ghi được file:", e)


def decrypt_file(cipher_name):
    input_file = input("File mã hóa: ").strip()
    output_file = input("File giải mã đầu ra: ").strip()

    try:
        cipher_bits = file_to_bits(input_file)
    except OSError as e:
        print("Không đọc được file:", e)
        return

    if cipher_name == "A5/1":
        key = input_a51_key()
        frame = input_frame((1 << 22) - 1)
        cipher = A51(key, frame)
    else:
        key = input_tiny_key()
        frame = input_frame(255)
        cipher = TinyA51(key, frame)

    key_stream = cipher.keystream(len(cipher_bits))
    plain_bits = xor_bits(cipher_bits, key_stream)

    try:
        bits_to_file(plain_bits, output_file)
        print(f"Đã giải mã: {input_file} -> {output_file}")
    except OSError as e:
        print("Không ghi được file:", e)


# ============================================================
# 7. HEX UTILITY
# ============================================================

def bits_to_hex(bits: str) -> str:
    if len(bits) % 8 != 0:
        raise ValueError("Số bit phải chia hết cho 8.")

    return " ".join(
        f"{int(bits[i:i+8], 2):02X}"
        for i in range(0, len(bits), 8)
    )


# ============================================================
# 8. DEMO CONVERSION
# ============================================================

def conversion_demo():
    print("\n===== DEMO TEXT <-> BIT =====")
    text = input("Nhập text: ")

    bits = text_to_bits(text)
    print("Text :", text)
    print("Bits :", bits)

    restored = bits_to_text(bits)
    print("Text khôi phục:", restored)


# ============================================================
# 9. MENUS
# ============================================================

def cipher_menu(cipher_name):
    while True:
        print(f"""
================ {cipher_name} ================
1. Mã hóa Text
2. Giải mã Text
3. Mã hóa File
4. Giải mã File
0. Quay lại
=================================================
""")

        choice = input("Chọn: ").strip()

        if choice == "1":
            encrypt_text(cipher_name)
        elif choice == "2":
            decrypt_text(cipher_name)
        elif choice == "3":
            encrypt_file(cipher_name)
        elif choice == "4":
            decrypt_file(cipher_name)
        elif choice == "0":
            break
        else:
            print("Lựa chọn không hợp lệ.")


def main():
    while True:
        print("""
=================================================
        A5/1 & TINY A5/1 CRYPTO SYSTEM
=================================================
1. A5/1
2. Tiny A5/1
3. Demo Text <-> Bit
0. Thoát
=================================================
""")

        choice = input("Chọn chức năng: ").strip()

        if choice == "1":
            cipher_menu("A5/1")
        elif choice == "2":
            cipher_menu("Tiny A5/1")
        elif choice == "3":
            conversion_demo()
        elif choice == "0":
            print("Kết thúc chương trình.")
            break
        else:
            print("Lựa chọn không hợp lệ.")


if __name__ == "__main__":
    main()

